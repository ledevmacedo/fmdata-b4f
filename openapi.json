{
  "openapi": "3.1.0",
  "info": {
    "title": "fmdata API",
    "description": "API pública, só de leitura e sem autenticação, sobre dados do Last.fm. As horas de /stats/listening-clock são UTC.",
    "contact": {
      "name": "fmdata-api",
      "url": "https://github.com/ledevmacedo/fmdata-api"
    },
    "license": {
      "name": ""
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Servidor local (PORT por omissão)"
    }
  ],
  "paths": {
    "/album-image": {
      "get": {
        "tags": [
          "Imagens"
        ],
        "summary": "Imagem de álbum",
        "description": "Devolve a imagem de um álbum de um artista.",
        "operationId": "album_image",
        "parameters": [
          {
            "name": "artist",
            "in": "query",
            "description": "Nome do artista (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Adele"
          },
          {
            "name": "album",
            "in": "query",
            "description": "Nome do álbum (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "25"
          }
        ],
        "responses": {
          "200": {
            "description": "Imagem do álbum encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumImageResponse"
                },
                "example": {
                  "album": "25",
                  "artist": "Adele",
                  "image_url": "https://lastfm-img.freetls.fastly.net/i/u/300x300/abc123.jpg"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro em falta ou vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "missing_parameter",
                    "message": "O parâmetro 'album' é obrigatório e não pode ser vazio."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Álbum desconhecido ou sem imagem disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Álbum 'Inexistente' de 'Adele' não encontrado."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/album-info": {
      "get": {
        "tags": [
          "Perfis"
        ],
        "summary": "Perfil de álbum",
        "description": "Devolve o perfil completo de um álbum de um artista.\n\nResponde com o registo tal como está em albuns_unicos.json, sem normalização:\ntracklist_names, tags e wiki_summary continuam a ser texto.",
        "operationId": "album_info",
        "parameters": [
          {
            "name": "artist",
            "in": "query",
            "description": "Nome do artista (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Adele"
          },
          {
            "name": "album",
            "in": "query",
            "description": "Nome do álbum (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "25"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do álbum",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Diretiva de cache HTTP; valor fixo: public, max-age=3600."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlbumProfile"
                },
                "example": {
                  "album_mbid": "1cafd438-383c-4068-a1cd-01c9cfdeb8a2",
                  "album_name": "25",
                  "artist_mbid": "",
                  "artist_name": "Adele",
                  "image_url": "https://lastfm-img.freetls.fastly.net/i/u/300x300/35a95375.png",
                  "listeners_global": 1208911,
                  "playcount_global": 35262463,
                  "release_date": "11 Nov 2021, 05:03",
                  "tags": "pop, soul, 2021, adele, british",
                  "track_count": 12,
                  "tracklist_names": "Strangers by Nature; Easy on Me; My Little Love; ...",
                  "url_lastfm": "https://www.last.fm/music/Adele/30",
                  "user_playcount": 1313,
                  "wiki_summary": "30 is the fourth studio album by Adele, released on November 19, 2021..."
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro em falta ou vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "missing_parameter",
                    "message": "O parâmetro 'album' é obrigatório e não pode ser vazio."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Álbum desconhecido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Álbum 'Inexistente' de 'Adele' não encontrado."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/artist-image": {
      "get": {
        "tags": [
          "Imagens"
        ],
        "summary": "Imagem de artista",
        "description": "Devolve a imagem de um artista.",
        "operationId": "artist_image",
        "parameters": [
          {
            "name": "artist",
            "in": "query",
            "description": "Nome do artista (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Adele"
          }
        ],
        "responses": {
          "200": {
            "description": "Imagem do artista encontrada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistImageResponse"
                },
                "example": {
                  "artist": "Adele",
                  "image_url": "https://lastfm-img.freetls.fastly.net/i/u/300x300/abc123.jpg"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro em falta ou vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "missing_parameter",
                    "message": "O parâmetro 'artist' é obrigatório e não pode ser vazio."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Artista desconhecido ou sem imagem disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Artista 'Desconhecido' não encontrado."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/artist-info": {
      "get": {
        "tags": [
          "Perfis"
        ],
        "summary": "Perfil de artista",
        "description": "Devolve o perfil completo de um artista.\n\nResponde com o registo tal como está em artistas_unicos.json, sem normalização:\ntags, similar_artists e bio_* continuam a ser texto.",
        "operationId": "artist_info",
        "parameters": [
          {
            "name": "artist",
            "in": "query",
            "description": "Nome do artista (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Adele"
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil do artista",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "Diretiva de cache HTTP; valor fixo: public, max-age=3600."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtistProfile"
                },
                "example": {
                  "bio_content": "Adele Laurie Blue Adkins (born 5 May 1988) is an English singer and songwriter...",
                  "bio_summary": "Adele Laurie Blue Adkins is an English singer and songwriter.",
                  "country_origin": "",
                  "image_url": "https://thumb.wikimedia.org/wikipedia/commons/.../330px-Adele_2016.jpg",
                  "listeners_global": 5791857,
                  "mbid": "cc2c9c3c-b7bc-4b8b-84d8-4fbd8779e493",
                  "name": "Adele",
                  "playcount_global": 327218625,
                  "similar_artists": "Sam Smith, Whitney Houston, Sienna Spiro, RAYE, Amy Winehouse",
                  "tags": "soul, female vocalists, british, singer-songwriter, indie",
                  "type": "",
                  "url_lastfm": "https://www.last.fm/music/Adele",
                  "url_musicbrainz": "https://musicbrainz.org/artist/cc2c9c3c-b7bc-4b8b-84d8-4fbd8779e493",
                  "url_wikipedia": "https://en.wikipedia.org/wiki/Adele",
                  "user_playcount": 4340,
                  "year_formed": ""
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro em falta ou vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "missing_parameter",
                    "message": "O parâmetro 'artist' é obrigatório e não pode ser vazio."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Artista desconhecido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Artista 'Desconhecido' não encontrado."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Estado do serviço",
        "description": "Indica se o serviço está no ar.\nNão acede a estado nem a dados: se o servidor responde, está funcional.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Serviço no ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/scrobbles": {
      "get": {
        "tags": [
          "Scrobbles"
        ],
        "summary": "Listar scrobbles",
        "description": "Devolve todos os scrobbles normalizados, pela ordem do ficheiro de dados.\nO array completo segue a ordem do ficheiro `reproducoes.json`; para um\nsubconjunto leve use `/scrobbles/amostra`.",
        "operationId": "list_scrobbles",
        "responses": {
          "200": {
            "description": "Array completo de scrobbles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Scrobble"
                  }
                },
                "example": [
                  {
                    "album_mbid": "",
                    "album_name": "25",
                    "artist_mbid": "",
                    "artist_name": "Adele",
                    "date_iso": "2026-01-01T03:30:00.000Z",
                    "date_uts": 1767238200,
                    "image_url": "https://lastfm-img.freetls.fastly.net/i/u/300x300/abc123.jpg",
                    "loved": 1,
                    "nowplaying": false,
                    "tags": "pop, soul",
                    "track_mbid": "",
                    "track_name": "Hello",
                    "track_url": "https://www.last.fm/music/Adele/_/Hello"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/scrobbles/amostra": {
      "get": {
        "tags": [
          "Scrobbles"
        ],
        "summary": "Amostra de scrobbles",
        "description": "Devolve os primeiros 100 scrobbles (ou menos, se existirem menos de 100),\npela mesma ordem de `/scrobbles`. Ideal para testar sem transferir tudo.",
        "operationId": "sample_scrobbles",
        "responses": {
          "200": {
            "description": "Amostra com até 100 scrobbles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Scrobble"
                  }
                },
                "example": [
                  {
                    "album_mbid": "",
                    "album_name": "25",
                    "artist_mbid": "",
                    "artist_name": "Adele",
                    "date_iso": "2026-01-01T03:30:00.000Z",
                    "date_uts": 1767238200,
                    "image_url": "https://lastfm-img.freetls.fastly.net/i/u/300x300/abc123.jpg",
                    "loved": 1,
                    "nowplaying": false,
                    "tags": "pop, soul",
                    "track_mbid": "",
                    "track_name": "Hello",
                    "track_url": "https://www.last.fm/music/Adele/_/Hello"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/stats/listening-clock": {
      "get": {
        "tags": [
          "Estatísticas"
        ],
        "summary": "Relógio de escuta por hora",
        "description": "Distribuição das reproduções pelas 24 horas do dia, em UTC.\nReproduções sem data válida (incluindo nowplaying) não são contadas.",
        "operationId": "listening_clock",
        "responses": {
          "200": {
            "description": "24 buckets ordenados por hora (0–23), em UTC",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/HourCount"
                  }
                },
                "example": [
                  {
                    "hour": 0,
                    "scrobbles": 12
                  },
                  {
                    "hour": 1,
                    "scrobbles": 7
                  }
                ]
              }
            }
          }
        }
      }
    },
    "/track-image": {
      "get": {
        "tags": [
          "Imagens"
        ],
        "summary": "Imagem de faixa",
        "description": "Devolve as imagens de uma faixa, ordenadas da maior para a mais pequena.",
        "operationId": "track_image",
        "parameters": [
          {
            "name": "artist",
            "in": "query",
            "description": "Nome do artista (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Adele"
          },
          {
            "name": "album",
            "in": "query",
            "description": "Nome do álbum (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "25"
          },
          {
            "name": "track",
            "in": "query",
            "description": "Nome da faixa (lookup case-insensitive).",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Hello"
          }
        ],
        "responses": {
          "200": {
            "description": "Imagens da faixa encontradas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TrackImageResponse"
                },
                "example": {
                  "album": "25",
                  "artist": "Adele",
                  "images": [
                    {
                      "size": "extralarge",
                      "url": "https://lastfm-img.freetls.fastly.net/i/u/300x300/abc123.jpg"
                    },
                    {
                      "size": "large",
                      "url": "https://lastfm-img.freetls.fastly.net/i/u/174s/abc123.jpg"
                    }
                  ],
                  "track": "Hello"
                }
              }
            }
          },
          "400": {
            "description": "Parâmetro em falta ou vazio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "missing_parameter",
                    "message": "O parâmetro 'track' é obrigatório e não pode ser vazio."
                  }
                }
              }
            }
          },
          "404": {
            "description": "Faixa desconhecida ou sem imagens disponíveis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "Nenhuma imagem disponível para a faixa 'Hello' do álbum '25' de 'Adele'."
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlbumImageResponse": {
        "type": "object",
        "description": "Imagem de um álbum.",
        "required": [
          "artist",
          "album",
          "image_url"
        ],
        "properties": {
          "album": {
            "type": "string",
            "description": "Nome do álbum, tal como pedido."
          },
          "artist": {
            "type": "string",
            "description": "Nome do artista, tal como pedido."
          },
          "image_url": {
            "type": "string",
            "description": "URL da imagem do álbum."
          }
        }
      },
      "AlbumProfile": {
        "type": "object",
        "description": "Perfil completo de um álbum, igual ao registo em `albuns_unicos.json`.",
        "properties": {
          "album_mbid": {
            "type": "string",
            "description": "MBID do álbum no MusicBrainz.",
            "default": ""
          },
          "album_name": {
            "type": "string",
            "description": "Nome do álbum.",
            "default": ""
          },
          "artist_mbid": {
            "type": "string",
            "description": "MBID do artista no MusicBrainz.",
            "default": ""
          },
          "artist_name": {
            "type": "string",
            "description": "Nome do artista.",
            "default": ""
          },
          "image_url": {
            "type": "string",
            "description": "URL da imagem do álbum.",
            "default": ""
          },
          "listeners_global": {
            "type": "integer",
            "format": "int64",
            "description": "Ouvintes globais no Last.fm.",
            "default": 0,
            "minimum": 0
          },
          "playcount_global": {
            "type": "integer",
            "format": "int64",
            "description": "Reproduções globais no Last.fm.",
            "default": 0,
            "minimum": 0
          },
          "release_date": {
            "type": "string",
            "description": "Data de lançamento (textual, pode estar vazia).",
            "default": ""
          },
          "tags": {
            "type": "string",
            "description": "Tags separadas por vírgula, tal como estão no ficheiro.",
            "default": ""
          },
          "track_count": {
            "type": "integer",
            "format": "int64",
            "description": "Número de faixas do álbum.",
            "default": 0,
            "minimum": 0
          },
          "tracklist_names": {
            "type": "string",
            "description": "Nomes das faixas, tal como está no ficheiro.",
            "default": ""
          },
          "url_lastfm": {
            "type": "string",
            "description": "URL do álbum no Last.fm.",
            "default": ""
          },
          "user_playcount": {
            "type": "integer",
            "format": "int64",
            "description": "Reproduções do utilizador no Last.fm.",
            "default": 0,
            "minimum": 0
          },
          "wiki_summary": {
            "type": "string",
            "description": "Resumo da wiki, tal como está no ficheiro.",
            "default": ""
          }
        }
      },
      "ArtistImageResponse": {
        "type": "object",
        "description": "Imagem de um artista.",
        "required": [
          "artist",
          "image_url"
        ],
        "properties": {
          "artist": {
            "type": "string",
            "description": "Nome do artista, tal como pedido."
          },
          "image_url": {
            "type": "string",
            "description": "URL da imagem do artista."
          }
        }
      },
      "ArtistProfile": {
        "type": "object",
        "description": "Perfil completo de um artista, igual ao registo em `artistas_unicos.json`.",
        "properties": {
          "bio_content": {
            "type": "string",
            "description": "Biografia completa, tal como está no ficheiro.",
            "default": ""
          },
          "bio_summary": {
            "type": "string",
            "description": "Resumo da biografia, tal como está no ficheiro.",
            "default": ""
          },
          "country_origin": {
            "type": "string",
            "description": "País de origem (textual, pode estar vazio).",
            "default": ""
          },
          "image_url": {
            "type": "string",
            "description": "URL da imagem do artista.",
            "default": ""
          },
          "listeners_global": {
            "type": "integer",
            "format": "int64",
            "description": "Ouvintes globais no Last.fm.",
            "default": 0,
            "minimum": 0
          },
          "mbid": {
            "type": "string",
            "description": "MBID do artista no MusicBrainz.",
            "default": ""
          },
          "name": {
            "type": "string",
            "description": "Nome do artista.",
            "default": ""
          },
          "playcount_global": {
            "type": "integer",
            "format": "int64",
            "description": "Reproduções globais no Last.fm.",
            "default": 0,
            "minimum": 0
          },
          "similar_artists": {
            "type": "string",
            "description": "Artistas semelhantes, tal como está no ficheiro.",
            "default": ""
          },
          "tags": {
            "type": "string",
            "description": "Tags separadas por vírgula, tal como estão no ficheiro.",
            "default": ""
          },
          "type": {
            "type": "string",
            "description": "Tipo de artista (textual, pode estar vazio).",
            "default": ""
          },
          "url_lastfm": {
            "type": "string",
            "description": "URL do artista no Last.fm.",
            "default": ""
          },
          "url_musicbrainz": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL da página no MusicBrainz; null quando o campo não existe no ficheiro.",
            "default": null
          },
          "url_wikipedia": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL da página na Wikipédia; null quando o campo não existe no ficheiro.",
            "default": null
          },
          "user_playcount": {
            "type": "integer",
            "format": "int64",
            "description": "Reproduções do utilizador no Last.fm.",
            "default": 0,
            "minimum": 0
          },
          "year_formed": {
            "type": "string",
            "description": "Ano de formação (textual, pode estar vazio).",
            "default": ""
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "description": "Detalhe de um erro da API.",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Código do erro: `missing_parameter` ou `not_found`."
          },
          "message": {
            "type": "string",
            "description": "Mensagem legível em português."
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Corpo JSON de uma resposta de erro.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail",
            "description": "Detalhe do erro devolvido pela API."
          }
        },
        "example": {
          "error": {
            "code": "not_found",
            "message": "Artista 'Desconhecido' não encontrado."
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "description": "Indicador de funcionamento — `{ \"status\": \"ok\" }`.",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Estado do serviço. Valor fixo: \"ok\"."
          }
        }
      },
      "HourCount": {
        "type": "object",
        "description": "Contagem de reproduções numa hora do dia (UTC).",
        "required": [
          "hour",
          "scrobbles"
        ],
        "properties": {
          "hour": {
            "type": "integer",
            "format": "int32",
            "description": "Hora do dia em UTC (0–23).",
            "minimum": 0
          },
          "scrobbles": {
            "type": "integer",
            "format": "int64",
            "description": "Número de reproduções nessa hora.",
            "minimum": 0
          }
        }
      },
      "Scrobble": {
        "type": "object",
        "description": "Reprodução (scrobble) normalizada a partir dos dados do Last.fm.",
        "required": [
          "track_name",
          "artist_name",
          "artist_mbid",
          "album_name",
          "album_mbid",
          "track_mbid",
          "track_url",
          "loved",
          "nowplaying",
          "tags"
        ],
        "properties": {
          "album_mbid": {
            "type": "string",
            "description": "MBID do álbum no MusicBrainz (pode ser vazio)."
          },
          "album_name": {
            "type": "string",
            "description": "Nome do álbum."
          },
          "artist_mbid": {
            "type": "string",
            "description": "MBID do artista no MusicBrainz (pode ser vazio)."
          },
          "artist_name": {
            "type": "string",
            "description": "Nome do artista."
          },
          "date_iso": {
            "type": [
              "string",
              "null"
            ],
            "description": "Data em formato ISO 8601 / RFC 3339; null se nowplaying ou data inválida."
          },
          "date_uts": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "Timestamp Unix em segundos; null se nowplaying ou data inválida.",
            "minimum": 0
          },
          "image_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "URL da imagem extralarge; null se indisponível."
          },
          "loved": {
            "type": "integer",
            "format": "int32",
            "description": "1 se a faixa está marcada como favorita, 0 caso contrário.",
            "minimum": 0
          },
          "nowplaying": {
            "type": "boolean",
            "description": "true se a reprodução está em curso; nesse caso as datas são null."
          },
          "tags": {
            "type": "string",
            "description": "Tags separadas por vírgula (pode ser vazio)."
          },
          "track_mbid": {
            "type": "string",
            "description": "MBID da faixa no MusicBrainz (pode ser vazio)."
          },
          "track_name": {
            "type": "string",
            "description": "Nome da faixa."
          },
          "track_url": {
            "type": "string",
            "description": "URL da faixa no Last.fm."
          }
        }
      },
      "SizedImage": {
        "type": "object",
        "description": "Imagem num tamanho específico.",
        "required": [
          "size",
          "url"
        ],
        "properties": {
          "size": {
            "type": "string",
            "description": "Tamanho: extralarge, large, medium ou small."
          },
          "url": {
            "type": "string",
            "description": "URL da imagem nesse tamanho."
          }
        }
      },
      "TrackImageResponse": {
        "type": "object",
        "description": "Imagens de uma faixa, por tamanho.",
        "required": [
          "artist",
          "album",
          "track",
          "images"
        ],
        "properties": {
          "album": {
            "type": "string",
            "description": "Nome do álbum, tal como pedido."
          },
          "artist": {
            "type": "string",
            "description": "Nome do artista, tal como pedido."
          },
          "images": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SizedImage"
            },
            "description": "Imagens disponíveis, da maior para a mais pequena."
          },
          "track": {
            "type": "string",
            "description": "Nome da faixa, tal como pedido."
          }
        }
      }
    }
